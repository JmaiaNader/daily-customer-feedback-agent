# Copy this file to .env and fill in your own values.
# Never commit .env or share your Gmail App Password.

# Desktop/local path is retained only for reference/testing; Scheduler does not use it.
DATA_FILE=data/sample_surveys.xlsx
SHEET_NAME=rowdata
# Local development: save the downloaded service-account JSON in this ignored folder.
GOOGLE_SERVICE_ACCOUNT_FILE=secrets/csat-feedback-writer.json
# For hosted deployments, use a private secret instead of committing a JSON key file.
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account", ...}
# Google Sheets API source used by the dashboard and scheduler.
# Share the native Google Sheet with the service account email as Editor.
DRIVE_DOWNLOAD_URL=https://docs.google.com/spreadsheets/d/YOUR_SPREADSHEET_ID/edit
REPORTS_DIR=reports
LOGS_DIR=logs

OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:4b

GMAIL_ADDRESS=youraddress@gmail.com
GMAIL_APP_PASSWORD=your_16_character_app_password
REPORT_EMAIL_TO=youraddress@gmail.com

# Use a separate PRIVATE Google Spreadsheet for report recipients. Do not use the public feedback-data workbook.
RECIPIENTS_SPREADSHEET_URL=https://docs.google.com/spreadsheets/d/YOUR_PRIVATE_RECIPIENTS_SPREADSHEET_ID/edit
RECIPIENTS_SHEET_NAME=recipient_lists
